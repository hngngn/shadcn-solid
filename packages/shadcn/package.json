{
  "name": "shadcn-solid",
  "version": "0.1.0",
  "description": "Schemas, presets, icons and transformers for shadcn-solid registry items.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "default": "./dist/preset/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "rs lib build",
    "dev": "rs lib --watch",
    "check": "rs check --fix",
    "check-types": "rs check --type-check"
  },
  "dependencies": {
    "@shadcn-solid/registry": "workspace:*",
    "cn": "^0.2.4",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "ts-morph": "^26.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.27"
  }
}
